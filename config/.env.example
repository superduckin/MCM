# 数据库配置示例 / Database Configuration Example
# 复制此文件为 .env 并填入真实配置 / Copy this file as .env and fill in real values

# MySQL 数据库配置 / MySQL Database Configuration
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mcm_database
DB_USER=your_username
DB_PASSWORD=your_password

# PostgreSQL 数据库配置 (可选) / PostgreSQL Configuration (Optional)
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mcm_database
# DB_USER=your_username
# DB_PASSWORD=your_password

# SQLite 数据库配置 (本地开发) / SQLite Configuration (Local Development)
# DB_TYPE=sqlite
# DB_PATH=database/mcm.db
